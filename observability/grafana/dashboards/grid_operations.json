          "rawSql": "SELECT wall_time AS time, grid_zone AS metric, 100 * renewable_share AS value FROM v_rt_zone_load WHERE $__timeFilter(wall_time) AND window_end <= (SELECT max(window_start) FROM rt_zone_load) ORDER BY 1",
