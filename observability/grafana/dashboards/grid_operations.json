    {
      "id": 11,
      "type": "table",
      "title": "Low renewable contribution alerts",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "griddb"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "griddb"
          },
          "rawSql": "SELECT to_char(window_start, 'YYYY-MM-DD HH24:MI') AS \"hour (simulated)\", grid_zone AS zone, severity, round((100 * value)::numeric, 1) AS \"renewable %\", message FROM grid_alerts ORDER BY created_at DESC LIMIT 15",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 6
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Latest daily billing report by zone (batch layer)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "griddb"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "griddb"
          },
          "rawSql": "SELECT sim_date::text AS \"simulated day\", grid_zone AS zone, households::text AS households, round(consumption_kwh::numeric, 1) AS \"consumption kWh\", round(solar_kwh::numeric, 1) AS \"solar kWh\", round((100 * renewable_share)::numeric, 1) AS \"renewable %\", round(total_billed::numeric, 2) AS \"billed LKR\" FROM daily_zone_summary WHERE sim_date = (SELECT max(sim_date) FROM daily_zone_summary) ORDER BY grid_zone",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 7
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Speed layer vs batch layer (latest day)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "griddb"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "griddb"
          },
          "rawSql": "SELECT sim_date::text AS \"simulated day\", grid_zone AS zone, round(batch_kwh::numeric, 2) AS \"batch kWh\", round(speed_kwh::numeric, 2) AS \"speed kWh\", round(diff_pct::numeric, 2) AS \"diff %\", (batch_readings - speed_readings)::text AS \"readings missed by speed layer\" FROM reconciliation WHERE sim_date = (SELECT max(sim_date) FROM reconciliation) ORDER BY grid_zone",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 7
      },
      "description": "The batch layer is exact; the difference is what arrived after the watermark",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
