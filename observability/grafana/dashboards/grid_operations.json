    {
      "id": 7,
      "type": "timeseries",
      "title": "Grid load by zone (kWh per 15-minute window)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "griddb"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "griddb"
          },
          "rawSql": "SELECT wall_time AS time, grid_zone AS metric, consumption_kwh AS value FROM v_rt_zone_load WHERE $__timeFilter(wall_time) AND window_end <= (SELECT max(window_start) FROM rt_zone_load) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "description": "Speed layer: tumbling 15-minute windows, plotted at the wall-clock time they occurred",
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
