      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "griddb"
          },
          "rawSql": "SELECT household_id AS household, grid_zone AS zone, billing_tier AS tier, round(consumption_kwh::numeric, 2) AS \"consumption kWh\", round(solar_kwh::numeric, 2) AS \"solar kWh\", solar_contribution_pct AS \"solar %\", tariff_rate AS rate, tariff_source AS \"tariff source\", total_bill AS \"bill LKR\" FROM daily_household_bill WHERE sim_date = (SELECT max(sim_date) FROM daily_household_bill) ORDER BY total_bill DESC LIMIT 8",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
