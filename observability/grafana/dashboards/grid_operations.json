  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Simulated time now",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "griddb"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "griddb"
          },
          "rawSql": "SELECT to_char(max(window_end), 'YYYY-MM-DD HH24:MI') AS sim_time FROM rt_zone_load",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "description": "1 simulated day = 5 minutes of wall-clock time",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
