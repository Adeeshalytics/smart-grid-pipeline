# Copy to .env to override. Every value below is already the default, so the
# stack runs without a .env file. These are local development credentials only.

POSTGRES_USER=grid
POSTGRES_PASSWORD=grid
S3_ACCESS_KEY=gridadmin
S3_SECRET_KEY=gridadmin123

# Simulated clock: wall-clock seconds per simulated day. Must be a multiple of 60
# that divides an hour (the Airflow schedule is derived from it). 300 = 5 minutes.
SIM_DAY_SECONDS=300

# Simulated fleet
NUM_HOUSEHOLDS=120
RANDOM_SEED=8203

# Speed layer
WATERMARK=30 minutes
LOW_RENEWABLE_THRESHOLD=0.20
